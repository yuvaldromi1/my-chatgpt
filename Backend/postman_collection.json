{
    "info": {
        "name": "Chat API",
        "description": "Request collection for testing the chat project REST API (FastAPI + MongoDB + OpenAI).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000"
        },
        {
            "key": "conversationId",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Create Conversation",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "// Save the conversationId to a collection variable for the next requests",
                            "var data = pm.response.json();",
                            "if (data.conversationId) {",
                            "    pm.collectionVariables.set('conversationId', data.conversationId);",
                            "}",
                            "pm.test('status is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/conversations",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "conversations"
                    ]
                },
                "description": "Create a new conversation. Returns a conversationId."
            }
        },
        {
            "name": "Send Message",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"content\": \"Hello! Who are you?\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "conversations",
                        "{{conversationId}}",
                        "messages"
                    ]
                },
                "description": "Send a user message and receive the chat reply for the created conversation."
            }
        },
        {
            "name": "Get Messages",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "conversations",
                        "{{conversationId}}",
                        "messages"
                    ]
                },
                "description": "Retrieve all messages in the conversation in chronological order."
            }
        }
    ]
}